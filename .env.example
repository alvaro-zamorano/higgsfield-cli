# Plantilla de ~/.higgsfield-cli/.env.local (la crea `hf init`). Nunca lo subas a Git.

# Higgsfield API, formato key-id:key-secret (https://open.higgsfield.ai/api-keys)
HF_KEY=

# Opcional: copia persistente en Cloudinary. Formato cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Opcionales
# HFCLI_CLOUDINARY_FOLDER=higgsfield
# HFCLI_OUTPUT=/ruta/absoluta/para/salidas
